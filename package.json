{
  "name": "archguide-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @archguide/web run dev",
    "archguide": "tsx packages/cli/src/bin.ts",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "schema": "pnpm --filter @archguide/core run schema",
    "schema:check": "pnpm --filter @archguide/core run schema:check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm depcruise && pnpm schema:check && pnpm content:check && pnpm rules-doc:check",
    "content": "pnpm --filter @archguide/profile-react-node-postgres run content",
    "content:check": "pnpm --filter @archguide/profile-react-node-postgres run content:check",
    "rules-doc": "pnpm --filter @archguide/profile-react-node-postgres run rules-doc",
    "rules-doc:check": "pnpm --filter @archguide/profile-react-node-postgres run rules-doc:check",
    "build": "turbo run build",
    "e2e": "pnpm --filter @archguide/web run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
